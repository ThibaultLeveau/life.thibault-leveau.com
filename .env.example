LIFE_ENVIRONMENT=development
LIFE_PUBLIC_BASE_URL=http://localhost:5173
LIFE_LOG_LEVEL=INFO
LIFE_DATABASE_URL=postgresql+psycopg://life:life-development-only@127.0.0.1:8102/life
LIFE_SESSION_HOURS=168
# Optional assistant keyring: comma-separated Fernet keys, first key encrypts new tokens.
# Generate a private key with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# LIFE_ASSISTANT_ENCRYPTION_KEYS=
LIFE_ASSISTANT_TIMEOUT_SECONDS=600
LIFE_ASSISTANT_MAX_MODEL_CALLS=96
LIFE_ASSISTANT_MAX_ACTIONS=200
# Development credentials only, matching compose.dev.yaml. Never use in production.
# Optional overrides. Relative paths are resolved from the project root.
# LIFE_FRONTEND_DIR=frontend/dist
# LIFE_DOCUMENTATION_DIR=site
