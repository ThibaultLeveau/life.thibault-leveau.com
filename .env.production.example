# Copy to .env.production and chmod 600. Generate a long random hexadecimal password.
# Use the SAME password in both values. Do not reuse the development password.
LIFE_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
LIFE_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
LIFE_DATABASE_URL=postgresql+psycopg://life:REPLACE_WITH_RANDOM_HEX@db:5432/life
LIFE_SESSION_HOURS=168
